# Copy to .env.development (local) or .env.production (deploy) and fill in.
# Only variables prefixed with VITE_ are bundled into client code. Never put secrets here.

# Backend API base URL. Leave empty until the backend exists; the UI then shows "not connected" states.
VITE_API_BASE_URL=

# Public origin of the deployed site (no trailing slash). Used for canonical URLs, sitemap.xml and robots.txt.
VITE_SITE_URL=https://smexstore.com
